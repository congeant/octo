{
  "name": "octo-dev",
  "version": "0.5.4",
  "description": "CLI for monorepo build orchestration, semantic versioning, and local infrastructure management",
  "type": "module",
  "license": "MIT",
  "author": "congeant",
  "repository": {
    "type": "git",
    "url": "https://github.com/congeant/octo.git"
  },
  "homepage": "https://github.com/congeant/octo#readme",
  "bugs": {
    "url": "https://github.com/congeant/octo/issues"
  },
  "keywords": [
    "cli",
    "monorepo",
    "build",
    "orchestration",
    "docker",
    "semver",
    "versioning",
    "infrastructure",
    "dependency-graph",
    "topological-sort"
  ],
  "bin": {
    "octo": "./bin/octo.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "execa": "^9.6.1",
    "@huggingface/transformers": "^4.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "semver": "^7.7.2",
    "tsx": "^4.19.4",
    "yaml": "^2.7.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.0",
    "fast-check": "^4.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
